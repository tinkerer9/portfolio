---
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    noindex?: boolean;
    canonical?: string;
    markdown?: string;
}

const { title, description, image, imageAlt, noindex, canonical, markdown } = Astro.props;


const buildDate = new Date().toLocaleString('en-US', {
    dateStyle: 'long',
    timeStyle: 'long',
    timeZone: 'UTC',
});
---

<!DOCTYPE html>
<Fragment set:html={`<!-- Last built on ${buildDate} with ${Astro.generator} -->`} />
<html lang="en" itemscope itemtype="https://schema.org/Article">
    <head>
        <MainHead
            title={title}
            description={description}
            image={image}
            imageAlt={imageAlt}
            noindex={noindex}
            canonical={canonical}
            markdown={markdown}
        />
    </head>
    <body>
        <div class="stack backgrounds">
            <Nav />
            <slot />
            <Footer />
        </div>

        <script>
            addEventListener('load', () => document.documentElement.classList.add('loaded'));
        </script>

        <style>
            :root {
                --bg-placeholder: linear-gradient(transparent, transparent);
                --bg-main: url('/assets/backgrounds/main-800w.jpg');
                --bg-main-curves: url('/assets/backgrounds/main.svg');
                --bg-subtle-1: var(--bg-placeholder);
                --bg-subtle-2: var(--bg-placeholder);
                --bg-footer: var(--bg-placeholder);
                --bg-svg-blend-mode: overlay;
                --bg-blend-mode: darken;
                --bg-aspect-ratio: 2.25;
                --bg-scale: 1.68;
                --bg-aspect-ratio: calc(var(--bg-aspect-ratio) / var(--bg-scale));
                --bg-gradient-size: calc(var(--bg-scale) * 100%);
            }
            :root.loaded {
                --bg-subtle-1: url('/assets/backgrounds/subtle-1-800w.jpg');
                --bg-subtle-2: url('/assets/backgrounds/subtle-2-800w.jpg');
                --bg-image-footer: url('/assets/backgrounds/footer-800w.jpg');
            }

            @media (min-width: 50em) {
                :root {
                    --bg-scale: 1;
                    --bg-main: url('/assets/backgrounds/main-1440w.jpg');
                }
                :root.loaded {
                    --bg-subtle-1: url('/assets/backgrounds/subtle-1-1440w.jpg');
                    --bg-subtle-2: url('/assets/backgrounds/subtle-2-1440w.jpg');
                    --bg-footer: url('/assets/backgrounds/footer-1440w.jpg');
                }
            }

            .backgrounds {
                min-height: 100%;
                isolation: isolate;
                background:
                    /*footer*/ var(--bg-footer) bottom center/var(--bg-gradient-size) no-repeat,
                    /*header1*/ var(--bg-main-curves) top center/var(--bg-gradient-size) no-repeat,
                    /*header2*/ var(--bg-main) top center/var(--bg-gradient-size) no-repeat,
                    /*base*/ var(--gray-999);
                background-blend-mode:
                    /*footer*/ var(--bg-blend-mode),
                    /*header1*/ var(--bg-svg-blend-mode),
                    /*header2*/ normal,
                    /*base*/ normal;
            }
            
            @media (forced-colors: active) {
                /* Deactivate custom backgrounds for high contrast users. */
                .backgrounds {
                    background: none;
                    background-blend-mode: none;
                    --bg-gradient-size: none;
                }
            }
        </style>
    </body>
</html>
