# Fonts (1 year)
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Backgrounds (30 days)
/assets/backgrounds/*
  Cache-Control: public, max-age=2592000

# Favicons (7 days)
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-96x96.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/web-app-manifest-192x192.png
  Cache-Control: public, max-age=604800
/web-app-manifest-512x512.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800