---
import '../styles/markdown.css';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import Comments from '../components/Comments.astro';
import { type CollectionEntry, render } from 'astro:content';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

const markdown = new URL(`/projects/${project.id}.md`, Astro.url).href;

const { Content } = await render(project);
---

<BaseLayout
    title={`${project.data.title} | Max Parisi`}
    description={project.data.description}
    image={project.data.image?.path}
    imageAlt={project.data.image?.alt}
    markdown={markdown}
    noindex={project.data.noindex}
>
    <div class="stack gap-15">
        <header>
            <div class="wrapper stack gap-2">
                <a class="back-link" href="/projects"><Icon icon="arrow-left" /> Projects</a>
                <Hero title={project.data.title} align="start">
                    <div class="details">
                        <div class="tags">
                            {
                                project.data.tags.map((tag: string) => (
                                    <Pill>{tag}</Pill>
                                ))
                            }
                        </div>
                        <p class="description">{project.data.description}</p>
                    </div>
                </Hero>
            </div>
        </header>
        
        <main class="wrapper">
            <div class="stack gap-10 content">
                <img src={project.data.image.path} alt={project.data.image.alt || ''} />
                <div class="markdown">
                    <Content />
                </div>
            </div>
        </main>

        { project.data.comments && (
            <section class="wrapper comments">
                <Comments />
            </section>
        )}
    </div>
</BaseLayout>

<style>
    header {
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--gray-800);
    }

    .back-link {
        display: none;
    }

    .details {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.5rem;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
    }

    .description {
        max-width: 54ch;
        font-size: var(--text-lg);
        text-wrap: balance;
    }

    .content {
        max-width: 65ch;
        margin-inline: auto;
    }

    .content > img {
        margin-bottom: 1rem;
    }

    .content > img {
        border: 1px solid var(--gray-800);
        border-radius: 1.5rem;
        background: var(--gradient-subtle);
        box-shadow: var(--shadow-sm);
    }

    .back-link {
        text-decoration: 1px solid underline transparent;
        text-underline-offset: 0.25em;
        transition: text-decoration-color var(--theme-transition);
    }

    .back-link:hover,
    .back-link:focus-visible {
        text-decoration-color: currentColor;
    }

    @media (min-width: 50em) {
        .back-link {
            display: block;
            align-self: flex-start;
        }

        .details {
            flex-direction: row;
            gap: 2.5rem;
        }
    }
</style>