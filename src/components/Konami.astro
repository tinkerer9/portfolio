<div class="konami-container">
    <slot />
</div>

<script>
    const container = document.querySelector<HTMLElement>('.konami-container');

    const KONAMI = [
        'ArrowUp',
        'ArrowUp',
        'ArrowDown',
        'ArrowDown',
        'ArrowLeft',
        'ArrowRight',
        'ArrowLeft',
        'ArrowRight',
        'b',
        'a',
    ];

    let position = 0;

    document.addEventListener('keydown', (e) => {
        const key = e.key;

        if (
            key === KONAMI[position] ||
            key.toLowerCase() === KONAMI[position]
        ) {
            position++;

            if (position === KONAMI.length) {
                position = 0;

                container?.animate(
                    [
                        { transform: "rotate(0deg)" },
                        { transform: "rotate(360deg)" }
                    ],
                    {
                        duration: 1000,
                        easing: 'ease-in-out',
                    }
                );
            }
        } else {
            position = key === KONAMI[0] ? 1 : 0;
        }
    });
</script>

<style>
    .konami-container {
        display: inline-block;
        transform-origin: center;
    }
</style>