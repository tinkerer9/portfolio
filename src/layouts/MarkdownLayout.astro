---
import Hero from '../components/Hero.astro';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout
    title={`${frontmatter.title} | Max Parisi`}
    description={frontmatter.description}
    image={frontmatter.img}
    imageAlt={frontmatter.img_alt}
    noindex={frontmatter.index === "false"}
>
    <div class="stack gap-15">
        <header>
            <div class="wrapper stack gap-2">
                <Hero
                    title={frontmatter.title}
                    tagline={frontmatter.description}
                />
            </div>
        </header>
        
        <main class="wrapper">
            <div class="stack gap-10 content">
                {frontmatter.img && <img src={frontmatter.img} alt={frontmatter.img_alt || ''} /> }
                <div class="markdown">
                    <slot />
                </div>
            </div>
        </main>

        {frontmatter.comments && (
            <section class="wrapper comments">
                <Comments />
            </section>
        )}
    </div>
</BaseLayout>

<style>
    .content {
        max-width: 65ch;
        margin-inline: auto;
    }

    .content > img {
        margin-bottom: 1rem;
    }

    .markdown > :global(* + *) {
        margin-top: 1rem;
    }

    .markdown :global(h1),
    .markdown :global(h2),
    .markdown :global(h3),
    .markdown :global(h4),
    .markdown :global(h5),
    .markdown :global(h6) {
        margin-block: 1.5rem;
    }

    .markdown :global(small) {
        font-size: var(--text-xs);
    }

    .markdown :global(img),
    .content > img {
        border: 1px solid var(--gray-800);
        border-radius: 1.5rem;
        background: var(--gradient-subtle);
        box-shadow: var(--shadow-sm);
    }

    .markdown :global(blockquote) {
        padding-inline-start: 1.5rem;
        border-inline-start: 0.25rem solid var(--accent-dark);
        color: var(--gray-0);
        font-family: var(--font-brand);
        font-size: var(--text-lg);
        font-weight: 600;
        line-height: 1.1;
    }

    .markdown :global(a) {
        text-decoration: 1px solid underline transparent;
        text-underline-offset: 0.25em;
        transition: text-decoration-color var(--theme-transition);
    }

    .markdown :global(a:hover),
    .markdown :global(a:focus-visible) {
        text-decoration-color: currentColor;
    }

    @media (min-width: 50em) {
        .markdown :global(blockquote) {
            font-size: var(--text-2xl);
        }
    }
</style>